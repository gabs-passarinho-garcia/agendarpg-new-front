{
  "version": 2,
  "framework": "angular",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "functions": {
    "api/index.ts": {
      "runtime": "vercel-bun@latest",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "api/index.ts"
    }
  ]
}
