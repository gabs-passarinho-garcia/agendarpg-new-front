{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "bunVersion": "1.x",
  "framework": "angular",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "api/index.ts"
    }
  ]
}
